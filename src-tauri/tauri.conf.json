{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek 用量",
  "version": "0.4.1",
  "identifier": "com.dsh.usage-stats",
  "build": {
    "frontendDist": "../src/renderer",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek 用量",
        "width": 420,
        "height": 660,
        "minWidth": 380,
        "minHeight": 520,
        "center": false,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
